  KEY `exchange_rates_pair_date_idx` (`from_currency`,`to_currency`,`rate_date`),
  KEY `exchange_rates_rate_date_index` (`rate_date`)
) ENGINE=InnoDB AUTO_INCREMENT=7 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
