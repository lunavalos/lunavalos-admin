(46,'5 de Mayo','<p>Crear Imagen de un camion de Absolute al estilo 5 de Mayo.</p><p><br></p><p>Celebrating strength, resilience, and movement 🇺🇸🇲🇽</p><p> This Cinco de Mayo, we keep your business moving forward.</p>','Media','Completados','support',46,NULL,NULL,NULL,NULL,'2026-05-05 19:34:16','2026-05-05 15:00:13','2026-05-05 19:34:16',9,9,'2026-05-05 00:00:00',0,'2026-05-05 14:55:31','2026-05-05 19:34:16',NULL),
(47,'Adquisición de dominio y desarrollo de sitio web corporativo de grupo','<p>Compra y configuración del dominio grupo-syacsa.com, junto con el desarrollo completo del sitio web corporativo que integre las empresas del grupo: syacsa.com, indutelsa.com.mx y RSD.</p><p><br></p><ul><li><strong>Adquisición de dominio: </strong>grupo-syacsa.com</li><li class=\"ql-indent-1\">Configuración inicial de DNS</li><li class=\"ql-indent-1\">Asignación a hosting / servidor</li><li><strong>Definir la arquitectura del sitio </strong></li><li><strong>Definición de secciones</strong> (nosotros, empresas, servicios, contacto, etc.)</li><li><strong>Diseño UI/UX </strong>alineada a <strong>identidad del grupo</strong></li><li>Adaptación responsive (desktop / mobile)</li><li><strong>Desarrollo del sitio </strong>Maquetación frontend</li><li>Creación de <strong>páginas</strong> individuales para mejorar el SEO:</li><li class=\"ql-indent-1\">syacsa - area especial sobre que es syacsa con btn para enlazar a su sitio</li><li class=\"ql-indent-1\">indutelsa - area especial sobre que es indutelsa con btn para enlazar a su sitio</li><li class=\"ql-indent-1\">RSD - area especial sobre que es RSD con btn para enlazar a su sitio</li><li><strong>Verificar funcionalidad de:</strong></li><li class=\"ql-indent-1\">Formularios de contacto</li><li class=\"ql-indent-1\">Enlaces entre sitios del grupo</li><li class=\"ql-indent-1\">SEO básico</li><li><strong>Carga de contenido:</strong></li><li class=\"ql-indent-1\">Textos, imágenes (Optimizadas) y datos de cada empresa</li><li><strong>Validación con cliente</strong></li><li><strong>Testing</strong></li><li class=\"ql-indent-1\">Pruebas de navegación</li><li class=\"ql-indent-1\">Validación en distintos dispositivos</li><li><strong>Deploy</strong></li><li class=\"ql-indent-1\">Publicación en dominio final</li><li class=\"ql-indent-1\">Configuración de SSL</li><li class=\"ql-indent-1\">Verificación final</li></ul><p><strong>Notas:</strong></p><ul><li>Confirmar si RSD cuenta con sitio web o solo será informativo</li><li>Definir si cada empresa tendrá<strong> branding independiente o unificado</strong></li></ul><p><br></p>','Media','Nuevos','support',NULL,NULL,NULL,NULL,NULL,'2026-05-05 15:35:23',NULL,NULL,9,NULL,'2026-06-30 00:00:00',0,'2026-05-05 15:35:23','2026-05-05 15:35:23',NULL),
(48,'Verificacion de traduccion para lunavalos.com','<p>Se asigna ticket a Sofia y Adam para verificacion de idiomas :)</p>','Baja','Nuevos','support',21,NULL,NULL,NULL,NULL,'2026-05-05 16:50:27',NULL,NULL,9,NULL,NULL,0,'2026-05-05 16:50:27','2026-05-05 16:50:27',NULL),
(49,'Correcciones en página de recetas – versión US','<p>Correcciones en página de recetas  para Estados Unidos</p>','Media','Completados','support',65,62,NULL,NULL,NULL,'2026-05-05 18:15:45','2026-05-05 18:14:56','2026-05-05 18:15:45',16,1,NULL,0,'2026-05-05 18:07:14','2026-05-05 18:15:45',NULL),
(50,'Actualizacion de sitio lpap.com.mx','<p>La nueva implementación será <strong>100% headless usando Payload CMS</strong>.</p><p><br></p><p><strong>Objetivo:</strong></p><p>Construir una tienda online completa, escalable y segura, replicando y mejorando el sitio actual, con control total desde el CMS.</p><p><br></p><p><strong>Tendremos 3 aplicaciones:</strong></p><ul><li><code>/admin</code> → Payload CMS (gestión interna)</li><li><code>/</code> → Tienda pública (frontend headless)</li><li><code>/app</code> → Portal de cliente (usuarios autenticados)</li></ul><p><br></p><p><strong>Stock Base:</strong></p><ul><li>Payload CMS (backend + CMS)</li><li>Frontend desacoplado (Next.js o similar)</li><li>Stripe (pagos)</li><li>Arquitectura headless</li><li>MONOREPO (todo en el mismo repo para hacer un solo deploy)</li></ul><p><br></p><p><strong>CMS Payload:</strong></p><p>Debe permitir gestionar:</p><ul><li>Productos (con variantes: sabor, presentación, etc.)</li><li>Categorías</li><li>Páginas dinámicas (con sistema de bloques)</li><li>Navegación (topnav + footer)</li><li>SEO (meta, OG, slugs, indexación)</li><li>Configuración global (logo, redes, contacto, etc.)</li></ul><p><br></p><p><strong>Tienda:</strong></p><ul><li>Carrito persistente</li><li>Checkout con Stripe</li><li>Creación de órdenes</li><li>Estados de pedido (pending, paid, shipped, etc.)</li><li>Snapshot de productos en órdenes (no referencias dinámicas)</li><li>Cálculo de impuestos y envío</li><li>Sistema de cupones / descuentos</li></ul><p><br></p><p><strong>Portal Cliente APP:</strong></p><ul><li>Registro / login</li><li>Perfil de usuario</li><li>Direcciones</li><li>Historial de pedidos</li></ul><p><br></p><p><strong>Stripe:</strong></p><ul><li>Integración con Stripe Checkout o Payment Intents</li><li>Manejo de webhooks</li><li>Sincronización automática con órdenes</li><li>Manejo de errores de pago</li></ul>','Media','En Proceso','support',NULL,NULL,NULL,NULL,NULL,'2026-05-05 19:31:15',NULL,NULL,9,15,'2026-06-08 00:00:00',0,'2026-05-05 19:30:57','2026-05-05 19:32:36','2026-05-05 19:32:36'),
(51,'Actualizacion lpap.com.mx','<p>La nueva implementación será <strong>100% headless usando Payload CMS</strong>.</p><p><br></p><p><strong>Objetivo:</strong></p><p>Construir una tienda online completa, escalable y segura, replicando y mejorando el sitio actual, con control total desde el CMS.</p><p><br></p><p><strong>Tendremos 3 aplicaciones:</strong></p><ul><li><code>/admin</code> → Payload CMS (gestión interna)</li><li><code>/</code> → Tienda pública (frontend headless)</li><li><code>/app</code> → Portal de cliente (usuarios autenticados)</li></ul><p><br></p><p><strong>Stock Base:</strong></p><ul><li>Payload CMS (backend + CMS)</li><li>Frontend desacoplado (Next.js o similar)</li><li>Stripe (pagos)</li><li>Arquitectura headless</li><li>MONOREPO (todo en el mismo repo para hacer un solo deploy)</li></ul><p><br></p><p><strong>CMS Payload:</strong></p><p>Debe permitir gestionar:</p><ul><li>Productos (con variantes: sabor, presentación, etc.)</li><li>Categorías</li><li>Páginas dinámicas (con sistema de bloques)</li><li>Navegación (topnav + footer)</li><li>SEO (meta, OG, slugs, indexación)</li><li>Configuración global (logo, redes, contacto, etc.)</li></ul><p><br></p><p><strong>Tienda:</strong></p><ul><li>Carrito persistente</li><li>Checkout con Stripe</li><li>Creación de órdenes</li><li>Estados de pedido (pending, paid, shipped, etc.)</li><li>Snapshot de productos en órdenes (no referencias dinámicas)</li><li>Cálculo de impuestos y envío</li><li>Sistema de cupones / descuentos</li></ul><p><br></p><p><strong>Portal Cliente APP:</strong></p><ul><li>Registro / login</li><li>Perfil de usuario</li><li>Direcciones</li><li>Historial de pedidos</li></ul><p><br></p><p><strong>Stripe:</strong></p><ul><li>Integración con Stripe Checkout o Payment Intents</li><li>Manejo de webhooks</li><li>Sincronización automática con órdenes</li><li>Manejo de errores de pago</li></ul><p><br></p>','Baja','En Proceso','support',29,NULL,NULL,NULL,NULL,'2026-05-05 19:32:20','2026-05-06 15:56:12',NULL,9,1,'2026-06-08 00:00:00',0,'2026-05-05 19:32:20','2026-05-27 15:56:12',NULL),
(52,'Problema al querer guardar una cotización grande','<p>Al hacer clic en \"guardar\", aparece un recuadro que dice: \"Error al cargar la página\" y no se autocompleta la información del producto de acuerdo a la barra de búsqueda.</p>','Urgente','Completados','support',47,73,NULL,NULL,NULL,'2026-05-06 16:38:07','2026-05-06 16:21:56','2026-05-06 16:38:07',22,22,'2026-05-06 00:00:00',0,'2026-05-06 15:48:53','2026-05-06 18:48:52',NULL),
