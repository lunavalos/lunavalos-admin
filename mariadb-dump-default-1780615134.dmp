(11,'Redirect de dominio a Kronos Logistics','<p>Redirigir el dominio: handcarriers.com a https://kronos-logistics.com/services/hand-carrier-service/</p><p><br></p><p>Datos del dominio:</p><p>Portal: https://www.networksolutions.com/my-account/login</p><p>User: daniela_solis24@hotmail.com</p><p>Pass: Dom.2025.!kronos</p><p><br></p>','Media','Completados','support',NULL,NULL,NULL,NULL,NULL,'2026-05-05 20:06:58','2026-05-05 20:06:49','2026-05-05 20:06:58',1,1,'2026-04-17 00:00:00',0,'2026-04-15 18:13:26','2026-05-05 20:06:58',NULL),
(12,'Dispositivos de Confianza','<p>Utilizar la funcionalidad de&nbsp;<strong>\"Dispositivos de Confianza\"</strong>&nbsp;o&nbsp;<strong>\"Recordar este navegador\"</strong>&nbsp;mediante cookies seguras<span style=\"color: rgb(10, 10, 10);\">. Esto permite omitir el código 2FA en computadoras personales, pero seguir solicitándolo en dispositivos nuevos o públicos.&nbsp;Con implementacion Segura y </span><span style=\"color: rgb(0, 29, 53);\">Mejores Prácticas para el Usuario y su Seguridad.</span></p><p><br></p>','Media','Completados','support',NULL,NULL,NULL,NULL,NULL,'2026-05-04 18:14:56','2026-05-04 18:14:43','2026-05-04 18:14:56',9,1,'2026-04-24 00:00:00',0,'2026-04-16 18:31:48','2026-05-04 18:14:56',NULL),
