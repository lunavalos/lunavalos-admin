INSERT INTO `ticket_messages` VALUES
(3,7,15,'<p>Subido a github</p>',NULL,'2026-04-14 19:33:14','2026-04-14 19:33:14'),
(4,9,16,'<p>revision</p>','tickets/attachments/PkTg05MMeQsgDkgJkhuVd51VkP4swG7XV16M5A9C.jpg','2026-04-15 14:50:57','2026-04-15 14:50:57'),
(5,7,1,'<p><strong>Cambios Ángel:</strong></p><ul><li>Agregar Video corto de maquinado o CNC para el Hero Banner, alinear el objeto a la derecha.</li><li>Mejorar imágenes de productos.</li><li>Crear logo en formato vertical sin texto pequeño para el navbar, y completo con variante en color blanco para el footer.</li></ul><p><br></p><p>Pasar el ticket a Adrián al terminar</p><p><br></p><p><strong>Cambios Adrián:</strong></p><ul><li>Eliminar Slideshow y aplicar video corto como background con tagline y botones alineados a la izquierda.</li><li>Segunda sección del homepage, eliminar la imagen de la izquierda, conservar el bloque de \"8+ Años de experiencia\" alineado con la lista, y alinear todo el texto a la izquierda.</li><li>Cambiar los colores azules al tono original del logo, verificar los colores secundarios a amarillo del logo, importante checar contrastes entre el texto y el fondo.</li></ul><p><br></p>',NULL,'2026-04-15 16:29:39','2026-04-15 16:29:39'),
(6,7,15,'<p>El proyecto se subió a Github</p><p>Cambios:</p><p>Se eliminó el slideshow y se agregó el video.</p><p>Se cambiaron los colores a los que se usan en el logo.</p><p>Se modificó la estructura de la segunda sección, que pasó a ser la tercera.</p><p>Se cambiaron las imágenes de los productos a las de mejor calidad.</p>',NULL,'2026-04-16 15:55:37','2026-04-16 15:55:37'),
(7,9,9,'<p>Quedo bien.</p>',NULL,'2026-04-16 18:34:56','2026-04-16 18:34:56'),
(8,9,9,'<p><br></p>',NULL,'2026-04-16 18:34:57','2026-04-16 18:34:57'),
(9,13,1,'<p>Lisxto calixto, tambien agregué un nuevo widget para ver los tickets de cada quien en el dashboard</p>',NULL,'2026-04-17 00:07:08','2026-04-17 00:07:08'),
(10,14,16,'<p>Link del video, https://drive.google.com/file/d/1uFxXaMPkpjiEFQ5OZaooXimHbgPI1GXH/view?usp=drive_link</p>',NULL,'2026-04-17 15:46:48','2026-04-17 15:46:48'),
(11,5,16,'<p>video , https://drive.google.com/file/d/1J4KXuvr--U2Hl4svVkst_hi7NDsUVJFi/view?usp=drive_link</p>',NULL,'2026-04-20 14:15:28','2026-04-20 14:15:28'),
(12,19,16,'<p>link del video https://drive.google.com/file/d/1fRBLNZocgeZe6-KZ6qzZ-NfJtMxpyP8I/view?usp=drive_link</p>',NULL,'2026-04-20 19:02:47','2026-04-20 19:02:47'),
(13,4,1,'<p>Mismo usuario para todos los idiomas:</p><p>u: kronos</p><p>p: (kr0n05.m45t3r)</p><p><br></p>',NULL,'2026-04-20 19:08:06','2026-04-20 19:08:06'),
(14,4,1,'<p>Mandarin&nbsp;</p><p><br></p><p>Kronos Logistics 具备进入全国主要机场保税区及海关监管区域的全部必要许可。</p><p><br></p><p>我们的操作人员经过专业培训，能够处理常规干货及危险品运输，同时持有 TAG 通行设备及 ANAM 工作证，可进行进出口货物的查验及报关操作。</p><p><br></p><p>目前，我们在以下航空口岸海关提供货运服务：</p><p><br></p><p>墨西哥城国际机场海关（AICM）</p><p>费利佩·安赫莱斯国际机场海关（AIFA / NLU）</p><p>瓜达拉哈拉国际机场海关（GDL）</p><p>蒙特雷国际机场海关（MTY）— Mariano Escobedo</p><p><br></p><p>我们拥有丰富的经验及先进技术，确保您的货物得到安全、高效的处理。</p>',NULL,'2026-04-20 19:12:55','2026-04-20 19:12:55'),
(15,4,1,'<p>Alemán:</p><p><br></p><p>Kronos Logistics verfügt über alle erforderlichen Genehmigungen für den Zugang zu Zoll- und Steuerzonen der wichtigsten Flughäfen des Landes.&nbsp;</p><p>&nbsp;</p><p>Unsere Mitarbeiter sind bestens geschult im Umgang mit regulären Trockengütern und Gefahrengut und verfügen zudem über TAG- und ANAM-Ausweise für die Abfertigung von Export- und Importgütern.&nbsp;</p><p>&nbsp;</p><p>Derzeit bieten wir Frachtdienstleistungen an den Luftfrachtzollstellen von&nbsp;</p><p>&nbsp;</p><p>ZOLLSTELLE DES INTERNATIONALEN FLUGHAFENS VON MEXIKO-STADT (AICM)</p><p>&nbsp;</p><p>ZOLLSTELLE DES INTERNATIONALEN FLUGHAFENS FELIPE ANGELES (AIFA NLU)</p><p>&nbsp;</p><p>Zollamt des Internationalen Flughafens von Guadalajara (GDL)</p><p>&nbsp;</p><p>Zollamt des Internationalen Flughafens von Monterrey (MTY) – General Mariano Escobedo&nbsp;</p><p>&nbsp;</p><p>Wir verfügen über umfassende Erfahrung und modernste Technologie für den sicheren Umgang mit Ihrer Fracht.</p>',NULL,'2026-04-20 19:13:47','2026-04-20 19:13:47'),
(16,20,1,'<p>Buen día, se ha eliminado Plaza Lúa de las sucursales, así como de la página de facturación.</p><p>También se ha corregido el texto en \"Cordillera\".</p><p><br></p><p>Favor de revisar los cambios, quedo atento a comentarios.</p>','tickets/attachments/sE868UB4XFyr62sQn36SZviLbXYJqOkf0TfqRW46.png','2026-04-21 08:08:15','2026-04-21 08:08:15'),
(17,15,1,'<p>Listo</p>','tickets/attachments/owZXcHv0G0YoTuGyEiFoC8FrMvscPgKVAg7m2wm3.png','2026-04-21 08:49:09','2026-04-21 08:49:09'),
(18,20,20,'<p>Hola, buen dia</p><p>Todo correcto, muchas gracias.</p><p><br></p><p>Saludos</p>',NULL,'2026-04-21 15:30:19','2026-04-21 15:30:19'),
