--
-- Table structure for table `ticket_canvas_items`
--

DROP TABLE IF EXISTS `ticket_canvas_items`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!40101 SET character_set_client = utf8mb4 */;
CREATE TABLE `ticket_canvas_items` (
  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,
  `ticket_id` bigint(20) unsigned NOT NULL,
  `parent_id` bigint(20) unsigned DEFAULT NULL,
  `position` int(10) unsigned NOT NULL DEFAULT 0,
  `stack_position` int(10) unsigned NOT NULL DEFAULT 0,
  `type` varchar(20) NOT NULL,
  `file_path` varchar(255) DEFAULT NULL,
  `file_name` varchar(255) DEFAULT NULL,
  `mime` varchar(255) DEFAULT NULL,
  `url` varchar(255) DEFAULT NULL,
  `caption` varchar(255) DEFAULT NULL,
  `approval_status` varchar(30) NOT NULL DEFAULT 'pending',
  `approval_note` text DEFAULT NULL,
  `uploaded_by` bigint(20) unsigned DEFAULT NULL,
  `created_at` timestamp NULL DEFAULT NULL,
  `updated_at` timestamp NULL DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `ticket_canvas_items_uploaded_by_foreign` (`uploaded_by`),
  KEY `ticket_canvas_items_ticket_id_position_index` (`ticket_id`,`position`),
  KEY `ticket_canvas_items_parent_id_stack_position_index` (`parent_id`,`stack_position`),
  CONSTRAINT `ticket_canvas_items_parent_id_foreign` FOREIGN KEY (`parent_id`) REFERENCES `ticket_canvas_items` (`id`) ON DELETE CASCADE,
  CONSTRAINT `ticket_canvas_items_ticket_id_foreign` FOREIGN KEY (`ticket_id`) REFERENCES `tickets` (`id`) ON DELETE CASCADE,
  CONSTRAINT `ticket_canvas_items_uploaded_by_foreign` FOREIGN KEY (`uploaded_by`) REFERENCES `users` (`id`) ON DELETE SET NULL
) ENGINE=InnoDB AUTO_INCREMENT=87 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

