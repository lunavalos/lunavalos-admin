--
-- Table structure for table `clients`
--

DROP TABLE IF EXISTS `clients`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!40101 SET character_set_client = utf8mb4 */;
CREATE TABLE `clients` (
  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,
  `user_id` bigint(20) unsigned DEFAULT NULL,
  `business_name` varchar(255) NOT NULL,
  `contact_name` varchar(255) DEFAULT NULL,
  `email` varchar(255) DEFAULT NULL,
  `phone` varchar(255) DEFAULT NULL,
  `rfc` varchar(20) DEFAULT NULL,
  `tax_regime` varchar(5) DEFAULT NULL,
  `cfdi_use` varchar(10) DEFAULT NULL,
  `tax_zip_code` varchar(10) DEFAULT NULL,
  `fiscal_address` varchar(255) DEFAULT NULL,
  `legal_name` varchar(255) DEFAULT NULL,
  `applies_iva` tinyint(1) NOT NULL DEFAULT 1,
  `iva_rate` decimal(6,4) NOT NULL DEFAULT 16.0000,
  `applies_isr_retention` tinyint(1) NOT NULL DEFAULT 0,
  `isr_retention_rate` decimal(6,4) NOT NULL DEFAULT 0.0000,
  `applies_iva_retention` tinyint(1) NOT NULL DEFAULT 0,
  `iva_retention_rate` decimal(6,4) NOT NULL DEFAULT 0.0000,
  `city` varchar(255) DEFAULT NULL,
  `agency_source` varchar(255) DEFAULT NULL,
  `contract_date` date DEFAULT NULL,
  `initial_price` decimal(12,2) DEFAULT NULL,
  `is_historical` tinyint(1) NOT NULL DEFAULT 0,
  `domain_names` varchar(255) DEFAULT NULL,
  `domain_provider` varchar(255) DEFAULT NULL,
  `hosting_provider` varchar(255) DEFAULT NULL,
  `email_provider` varchar(255) DEFAULT NULL,
  `has_custom_email_config` tinyint(1) NOT NULL DEFAULT 0,
  `imap_host` varchar(255) DEFAULT NULL,
  `imap_port` varchar(255) DEFAULT NULL,
  `imap_tls` tinyint(1) NOT NULL DEFAULT 1,
  `pop_host` varchar(255) DEFAULT NULL,
  `pop_port` varchar(255) DEFAULT NULL,
  `pop_tls` tinyint(1) NOT NULL DEFAULT 1,
  `smtp_host` varchar(255) DEFAULT NULL,
  `smtp_port` varchar(255) DEFAULT NULL,
  `smtp_tls` tinyint(1) NOT NULL DEFAULT 1,
  `login_credentials` text DEFAULT NULL,
  `vault_credentials` longtext DEFAULT NULL,
  `email_accounts` longtext CHARACTER SET utf8mb4 COLLATE utf8mb4_bin DEFAULT NULL CHECK (json_valid(`email_accounts`)),
  `notes` text DEFAULT NULL,
  `created_at` timestamp NULL DEFAULT NULL,
  `updated_at` timestamp NULL DEFAULT NULL,
  `quote_id` bigint(20) unsigned DEFAULT NULL,
  `quote_file_path` varchar(255) DEFAULT NULL,
  `contract_file_path` varchar(255) DEFAULT NULL,
  `branding_file_path` varchar(255) DEFAULT NULL,
  `receipt_file_path` varchar(255) DEFAULT NULL,
  `briefing_context` text DEFAULT NULL,
  `briefing_target_audience` text DEFAULT NULL,
  `briefing_competitors` text DEFAULT NULL,
  `briefing_references` text DEFAULT NULL,
  `briefing_contact_methods` text DEFAULT NULL,
  `briefing_current_emails` text DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `clients_user_id_foreign` (`user_id`),
  KEY `clients_quote_id_foreign` (`quote_id`),
  KEY `clients_rfc_index` (`rfc`),
  KEY `clients_tax_regime_index` (`tax_regime`),
  CONSTRAINT `clients_quote_id_foreign` FOREIGN KEY (`quote_id`) REFERENCES `quotes` (`id`) ON DELETE SET NULL,
  CONSTRAINT `clients_user_id_foreign` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`) ON DELETE SET NULL
) ENGINE=InnoDB AUTO_INCREMENT=76 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

