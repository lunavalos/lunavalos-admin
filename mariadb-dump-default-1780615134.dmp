DROP TABLE IF EXISTS `ticket_canvas_pins`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!40101 SET character_set_client = utf8mb4 */;
CREATE TABLE `ticket_canvas_pins` (
  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,
  `canvas_item_id` bigint(20) unsigned NOT NULL,
  `x_pct` decimal(6,3) NOT NULL,
  `y_pct` decimal(6,3) NOT NULL,
  `comment` text NOT NULL,
  `resolved` tinyint(1) NOT NULL DEFAULT 0,
  `user_id` bigint(20) unsigned DEFAULT NULL,
  `created_at` timestamp NULL DEFAULT NULL,
  `updated_at` timestamp NULL DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `ticket_canvas_pins_user_id_foreign` (`user_id`),
  KEY `ticket_canvas_pins_canvas_item_id_index` (`canvas_item_id`),
  CONSTRAINT `ticket_canvas_pins_canvas_item_id_foreign` FOREIGN KEY (`canvas_item_id`) REFERENCES `ticket_canvas_items` (`id`) ON DELETE CASCADE,
  CONSTRAINT `ticket_canvas_pins_user_id_foreign` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`) ON DELETE SET NULL
) ENGINE=InnoDB AUTO_INCREMENT=2 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

