--
-- Table structure for table `tickets`
--

DROP TABLE IF EXISTS `tickets`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!40101 SET character_set_client = utf8mb4 */;
CREATE TABLE `tickets` (
  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,
  `title` varchar(255) NOT NULL,
  `content` longtext DEFAULT NULL,
  `priority` varchar(255) NOT NULL DEFAULT 'Media',
  `status` varchar(255) NOT NULL DEFAULT 'Nuevos',
  `source_type` enum('support','recurring') NOT NULL DEFAULT 'support',
  `client_id` bigint(20) unsigned DEFAULT NULL,
  `client_service_id` bigint(20) unsigned DEFAULT NULL,
  `billing_cycle_id` bigint(20) unsigned DEFAULT NULL,
  `deliverable_credit_id` bigint(20) unsigned DEFAULT NULL,
  `sequence_number` int(10) unsigned DEFAULT NULL,
  `status_updated_at` timestamp NULL DEFAULT NULL,
  `work_started_at` timestamp NULL DEFAULT NULL,
  `work_finished_at` timestamp NULL DEFAULT NULL,
  `creator_id` bigint(20) unsigned NOT NULL,
  `assigned_id` bigint(20) unsigned DEFAULT NULL,
  `due_date` timestamp NULL DEFAULT NULL,
  `is_archived` tinyint(1) NOT NULL DEFAULT 0,
  `created_at` timestamp NULL DEFAULT NULL,
  `updated_at` timestamp NULL DEFAULT NULL,
  `deleted_at` timestamp NULL DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `tickets_creator_id_foreign` (`creator_id`),
  KEY `tickets_assigned_id_foreign` (`assigned_id`),
  KEY `tickets_client_id_foreign` (`client_id`),
  KEY `tickets_client_service_id_foreign` (`client_service_id`),
  KEY `tickets_billing_cycle_id_foreign` (`billing_cycle_id`),
  KEY `tickets_deliverable_credit_id_foreign` (`deliverable_credit_id`),
  KEY `tickets_source_type_index` (`source_type`),
  CONSTRAINT `tickets_assigned_id_foreign` FOREIGN KEY (`assigned_id`) REFERENCES `users` (`id`) ON DELETE SET NULL,
  CONSTRAINT `tickets_billing_cycle_id_foreign` FOREIGN KEY (`billing_cycle_id`) REFERENCES `billing_cycles` (`id`) ON DELETE SET NULL,
  CONSTRAINT `tickets_client_id_foreign` FOREIGN KEY (`client_id`) REFERENCES `clients` (`id`) ON DELETE SET NULL,
  CONSTRAINT `tickets_client_service_id_foreign` FOREIGN KEY (`client_service_id`) REFERENCES `client_services` (`id`) ON DELETE SET NULL,
  CONSTRAINT `tickets_creator_id_foreign` FOREIGN KEY (`creator_id`) REFERENCES `users` (`id`) ON DELETE CASCADE,
  CONSTRAINT `tickets_deliverable_credit_id_foreign` FOREIGN KEY (`deliverable_credit_id`) REFERENCES `deliverable_credits` (`id`) ON DELETE SET NULL
) ENGINE=InnoDB AUTO_INCREMENT=99 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

--
-- Dumping data for table `tickets`
--

SET @OLD_AUTOCOMMIT=@@AUTOCOMMIT, @@AUTOCOMMIT=0;
LOCK TABLES `tickets` WRITE;
/*!40000 ALTER TABLE `tickets` DISABLE KEYS */;
INSERT INTO `tickets` VALUES
(4,'Agregar nueva sección en Kronos Logistics','<p><strong>Español&nbsp;</strong></p><p><br></p><p>Kronos Logistics cuenta con todos los permisos necesarios para el ingreso a recintos fiscales y aduanas&nbsp;de los principales aeropuertos del país.&nbsp;</p><p><br></p><p>Nuestros operadores están altamente capacitados en el manejo de carga seca regular y materiales peligrosos&nbsp;además de contar con con TAG y Gafete ANAM para la modulación y despacho de mercancías de exportación e importación.&nbsp;</p><p><br></p><p>Actualmente brindamos servicios de carga en las aduanas aéreas de&nbsp;</p><p><br></p><p><br></p><p>ADUANA DEL AEROPUERTO INTERNACIONAL DE LA CIUDAD DE MEXICO ( AICM )</p><p><br></p><p>ADUANA AEROPUERTO INTERNACIONAL FELIPE ANGELES ( AIFA NLU )</p><p><br></p><p>Aduana del Aeropuerto Internacional de Guadalajara (GDL)</p><p><br></p><p><br></p><p>Aduana del Aeropuerto Internacional de Monterrey (MTY) - General Mariano Escobedo&nbsp;</p><p><br></p><p>Contamos con amplia experiencia y tecnología para el manejo seguro de tu mercancía.</p><p><br></p><p><br></p><p><strong>Ingles</strong></p><p><br></p><p>Kronos Logistics holds all the necessary permits to access bonded facilities and customs at the country’s main airports.</p><p><br></p><p>Our drivers are highly trained in handling general dry cargo and hazardous materials, and they are equipped with TAG and ANAM ID credentials for the clearance and dispatch of import and export shipments.</p><p><br></p><p>We currently provide cargo services at the following air customs offices:</p><p><br></p><p>MEXICO CITY INTERNATIONAL AIRPORT CUSTOMS (AICM)</p><p><br></p><p>FELIPE ÁNGELES INTERNATIONAL AIRPORT CUSTOMS (AIFA – NLU)</p><p><br></p><p>GUADALAJARA INTERNATIONAL AIRPORT CUSTOMS (GDL)</p><p><br></p><p>MONTERREY INTERNATIONAL AIRPORT CUSTOMS (MTY) – General Mariano Escobedo</p><p><br></p><p>We have extensive experience and advanced technology to ensure the safe handling of your cargo.</p><p><br></p><p><strong>Coreano&nbsp;</strong></p><p><br></p><p>크로노스 로지스틱스는 국내 주요 공항의 세관 및 보세구역 출입에 필요한 모든 허가를 보유하고 있습니다.</p><p><br></p><p>당사의 운송 담당자들은 일반 건식 화물뿐만 아니라 위험물 취급에 대해 높은 수준의 전문 교육을 이수하였으며, 수출입 화물의 통관 및 반출입 절차를 원활하게 수행하기 위해 TAG 및 ANAM 출입증을 보유하고 있습니다.</p><p><br></p><p>현재 당사는 다음 공항 세관에서 화물 운송 서비스를 제공하고 있습니다:</p><p><br></p><p>멕시코시티 국제공항 세관 (AICM)</p><p>펠리페 앙헬레스 국제공항 세관 (AIFA NLU)</p><p>과달라하라 국제공항 세관 (GDL)</p><p>몬테레이 국제공항 세관 (MTY) – 헤네랄 마리아노 에스코베도</p><p><br></p><p>당사는 풍부한 경험과 첨단 기술을 바탕으로 고객님의 화물을 안전하게 처리합니다.</p><p><br></p><p><br></p><p><br></p><p><strong>Mandarin - Pendiente&nbsp;</strong></p><p><br></p><p><strong>Alemán - Pendiente</strong></p>','Media','Completados','support',NULL,NULL,NULL,NULL,NULL,'2026-05-14 14:52:41',NULL,NULL,1,1,'2026-04-21 00:00:00',0,'2026-04-14 16:57:03','2026-05-14 14:52:41',NULL),
(5,'video lunavalos','<p>Video</p>','Media','Completados','support',NULL,NULL,NULL,NULL,NULL,'2026-04-22 16:48:07',NULL,NULL,16,9,NULL,0,'2026-04-14 19:02:48','2026-04-22 16:48:07',NULL),
(6,'INFORMACIÓN PARA LA PÁGINA WEB','<p><span style=\"color: rgb(0, 0, 0);\">Dominio trazamapas.com.mx</span></p><p><span style=\"color: rgb(0, 0, 0);\">Vence el 04 de marzo 2027</span></p><p><br></p><p><span style=\"color: rgb(0, 0, 0);\">Cosas que queremos destacar:</span></p><p><br></p><p><span style=\"color: rgb(0, 0, 0);\">Agencia de viajes al norte de Saltillo, ofrecemos viajes nacionales e internacionales&nbsp;</span></p><p><span style=\"color: rgb(0, 0, 0);\">Somos Agentes Certificados Disney y Universal</span></p><p><span style=\"color: rgb(0, 0, 0);\">Hotelería destacada Xcaret y Hotel Nickelodeon</span></p><p><span style=\"color: rgb(0, 0, 0);\">Cruceros</span></p><p><span style=\"color: rgb(0, 0, 0);\">Bodas en destino</span></p><p><br></p><p><span style=\"color: rgb(0, 0, 0);\">Servicios adicionales que le ofrecemos a nuestros clientes:</span></p><p><br></p><p><span style=\"color: rgb(0, 0, 0);\">Seguros de viaje</span></p><p><br></p><p><span style=\"color: rgb(0, 0, 0);\">Vendemos eSIM de internet ilimitado para viajes con Holafly a través de este enlace para recibir comisión:</span><a href=\"https://holafly.sjv.io/EEr52D\" target=\"_blank\" style=\"color: rgb(0, 0, 0);\"> </a><a href=\"https://holafly.sjv.io/EEr52D\" target=\"_blank\" style=\"color: rgb(17, 85, 204);\">https://holafly.sjv.io/EEr52D</a></p><p><br></p><p><span style=\"color: rgb(0, 0, 0);\">Manejamos dos páginas para ofrecer a nuestros clientes tours o tickets para museos o sitios de interés en todo el mundo, el cliente nos dice cuál actividad les interesa y nosotros les generamos un enlace de compra para recibir comisión a través de las páginas de Civitatis y GuetYourGuide</span></p><p><br></p><p><span style=\"color: rgb(0, 0, 0);\">Enlace Civitatis: </span><a href=\"https://www.civitatis.com/es/agencias/?srsltid=AfmBOoqHbDnVpbbxH8hSf2VeNoPHbAVEO8efx2ulvwLY_2kDhoCQVxJ3\" target=\"_blank\" style=\"color: rgb(17, 85, 204);\">https://www.civitatis.com/es/agencias/?srsltid=AfmBOoqHbDnVpbbxH8hSf2VeNoPHbAVEO8efx2ulvwLY_2kDhoCQVxJ3</a></p><p><br></p><p><span style=\"color: rgb(0, 0, 0);\">Enlace GuetYourGuide:</span><a href=\"https://partner.getyourguide.com/es-es/booking\" target=\"_blank\" style=\"color: rgb(0, 0, 0);\"> </a><a href=\"https://partner.getyourguide.com/es-es/booking\" target=\"_blank\" style=\"color: rgb(17, 85, 204);\">https://partner.getyourguide.com/es-es/booking</a></p><p><br></p><p><span style=\"color: rgb(0, 0, 0);\">Tenemos 1 principal proveedor para destinos nacionales, Prices Agencies, que también ofrece venta al cliente final a través de su página Prace Travel, pero maneja una plataforma exclusiva para agencias de viajes mediante la cual operamos: </span><a href=\"https://res.priceagencies.com.mx/login?absoluteUri=http%3A%2F%2Fres.priceagencies.com.mx%2Finicio\" target=\"_blank\" style=\"color: rgb(17, 85, 204);\">https://res.priceagencies.com.mx/login?absoluteUri=http%3A%2F%2Fres.priceagencies.com.mx%2Finicio</a></p><p><br></p><p><span style=\"color: rgb(0, 0, 0);\">Un punto importante de por qué manejamos este proveedor es que nos da la oportunidad de ofrecer a nuestros clientes la opción de pago con Tarjeta de Crédito a Meses Sin Intereses.</span></p><p><br></p><p><span style=\"color: rgb(0, 0, 0);\">Manejamos dos principales proveedores para circuitos internacionales, los cuáles venden sus paquetes exclusivamente a través de agencias de viajes, no venden al cliente final:</span></p><p><br></p><p><span style=\"color: rgb(0, 0, 0);\">Nefertari:</span><a href=\"https://nefertaritravel.com.mx/\" target=\"_blank\" style=\"color: rgb(0, 0, 0);\"> </a><a href=\"https://nefertaritravel.com.mx/\" target=\"_blank\" style=\"color: rgb(17, 85, 204);\">https://nefertaritravel.com.mx</a></p><p><span style=\"color: rgb(0, 0, 0);\">MegaTravel:</span><a href=\"https://www.megatravel.com.mx/\" target=\"_blank\" style=\"color: rgb(0, 0, 0);\"> </a><a href=\"https://www.megatravel.com.mx/\" target=\"_blank\" style=\"color: rgb(17, 85, 204);\">https://www.megatravel.com.mx</a></p>','Media','Nuevos','support',NULL,NULL,NULL,NULL,NULL,'2026-04-14 19:14:25',NULL,NULL,14,NULL,NULL,0,'2026-04-14 19:14:25','2026-04-14 19:14:25',NULL),
