INSERT INTO `services` VALUES
(30,'Sitio Web Bronze','Un sitio web sencillo con contenido breve pero informativo, su diseño es de una sola pagina donde toda tu información se centrará. \nEste tipo de pagina web es especial para negocios que desean\nmostrarse de manera breve, ideal para comenzar tu presencia online.\n\n- Diseño web responsivo, totalmente funcional en móviles, tablets y computadoras.\n- Método para que el visitante se ponga en contacto, botones de llamada, mensaje por WhatsApp, Facebook Chat integrado formulario de contacto. (llamado a la acción)\n- Alta de oficinas en Google my business\n- Optimización de acuerdo a estándares de Google\n- Certificado de seguridad SSL y ReCaptcha de google para la seguridad en formularios\n- Registro de Dominio (la cotización puede variar dependiendo del nombre)\n- Cuenta de Hospedaje flexible con: 10GB Espacio en web - Bandwidth 3GB - 5 Correos - SSL\n- Soporte sitio web y mantenimiento hosting',12000.00,3700.00,'MXN','annual','2026-04-06 15:32:40','2026-04-06 19:44:00',0,NULL,NULL,1),
(31,'Sitio Web Silver','Muestra todo sobre tu negocio, información, galerías, catálogos, servicios etc. envuelve a tu audiencia con un contenido más informativo y creativo, este tipo de sitios son excelentes para que las personas conozcan más sobre tu marca, creando una experiencia de usuario más satisfactoria.\n\n- Diseño web responsivo, totalmente funcional en móviles, tablets y computadoras.\n- Método para que el visitante se ponga en contacto, botones de llamada, mensaje por WhatsApp, Facebook Chat integrado formulario de contacto. (llamado a la acción)\n- Alta de oficinas en Google my business\n- Optimización de acuerdo a estándares de Google\n- Certificado de seguridad SSL y ReCaptcha de google para la seguridad en formularios\n- Registro de Dominio (la cotización puede variar dependiendo del nombre)\n- Cuenta de Hospedaje flexible con: 24GB Espacio en web - Bandwidth 10GB - Correos 10 - SSL\n- Soporte sitio web y mantenimiento hosting (solo si se adquiere con hosting y dominio)',18500.00,4300.00,'MXN','annual','2026-04-06 19:41:50','2026-04-06 19:45:43',0,NULL,NULL,1),
(32,'Sitio Web Gold','Muy similar al silver pero con la facilidad de gestionar tu mismo el contenido contando siempre con un\nequipo de asesoria y soporte. Nosotros hacemos que todo funcione para ti, este paquete es\nespecial para creadores de contenido como bloggers, noticias, informes, funcionalidades avanzadas etc.\n\n\nDiseño web responsivo, totalmente funcional en móviles, tablets y computadoras.\n- Método para que el visitante se ponga en contacto, botones de llamada, mensaje por WhatsApp, Facebook Chat integrado formulario de contacto. (llamado a la acción)\n- Alta de oficinas en Google my business\n- Optimización de acuerdo a estándares de Google\n- Certificado de seguridad SSL y ReCaptcha de google para la seguridad en formularios\n- Registro de Dominio (la cotización puede variar dependiendo del nombre)\n- Cuenta de Hospedaje flexible con: 48GB Espacio en web - Bandwidth 20GB - - Correos 20 - SSL\n- Soporte sitio web y mantenimiento hosting',28700.00,5800.00,'MXN','annual','2026-04-06 19:49:47','2026-04-06 19:49:47',0,NULL,NULL,1),
(33,'Sitio Web Platinum','El sitio de ventas online, cuenta con todas las características del paquete Gold pero especial para ventas donde podrás administrar tu inventario, gestionar ordenes y envíos, configurar métodos de pagos seguros, crear cupones para promociones con descuento, aplicar descuentos directos a productos por temporada. Es el sitio web ideal para introducir tu negocio al comercio electrónico.\n\n- Diseño web responsivo, totalmente funcional en móviles, tablets y computadoras.\n- Método para que el visitante se ponga en contacto, botones de llamada, mensaje por WhatsApp, Facebook Chat integrado formulario de contacto. (llamado a la acción)\n- Alta de oficinas en Google my business\n- Optimización de acuerdo a estándares de Google\n- Certificado de seguridad SSL y ReCaptcha de google para la seguridad en formularios\n- Registro de Dominio (la cotización puede variar dependiendo del nombre)\n- Cuenta de Hospedaje flexible con: 48GB Espacio en web - Bandwidth 20GB - - Correos 20 - SSL\n- Soporte sitio web y mantenimiento hosting',75000.00,7200.00,'MXN','annual','2026-04-06 19:55:34','2026-04-06 19:55:34',0,NULL,NULL,1),
(34,'Landing Page',NULL,7200.00,3200.00,'MXN','annual','2026-04-06 20:06:59','2026-04-06 20:06:59',0,NULL,NULL,1),
(35,'Hosting Only','Plantilla de contacto incluída',3200.00,3200.00,'MXN','annual','2026-04-06 20:07:56','2026-04-06 20:07:56',0,NULL,NULL,1),
(36,'SEO Content & Website Management','Solución integral de marketing digital diseñada para fortalecer la presencia de tu marca, aumentar la visibilidad y potenciar el crecimiento de tu negocio. Mediante la gestión de redes sociales, el email marketing, la optimización de Google My Business y el contenido estratégico para tu sitio web, te ayudamos a crear una presencia digital más sólida.',850.00,0.00,'USD','monthly','2026-05-20 03:04:40','2026-05-20 03:17:49',0,NULL,'[]',24),
(37,'Patrocinado','Website, Email MKT, Redes, Blog, Google profile.',1.00,1.00,'MXN','monthly','2026-05-21 17:55:54','2026-05-21 17:55:54',0,NULL,'[]',12),
(38,'Renovación de Dominio','Renovación de Dominio .com por un año',380.00,0.00,'MXN','unique','2026-05-28 18:24:57','2026-05-28 18:24:57',0,'dominio','[\"dominio\"]',1),
(39,'SEO Content & Website Management','Fortalecer la presencia de tu marca, aumentando la visibilidad de tu negocio. Con constante optimización de contenido estratégico para tu sitio web, te ayudamos a crear una presencia digital más sólida de manera integral.',3000.00,0.00,'MXN','monthly','2026-06-02 16:44:58','2026-06-02 16:44:58',0,NULL,'[]',12),
(40,'Servicio Web + Data Analysis','- Administración Web + Tienda en linea\n- Redes Sociales (8 Reels + Gráficos + Animaciones 3D)\n- Email Marketing (4 correos semanales + Administración de base de datos de emails)\n- Blog + Contenido editorial (4 posts por mes)\n- Documentos digitales (adaptación de formatos + tarjetas digitales)\n- Solicitudes especiales de diseño (Atención a requerimientos específicos)\n- Soporte técnico (monitoreo de servidores 24/7, backups diarios)\n- Análisis de datos de búsqueda de marcas para campañas de SEO\n- Alfabetización de seguridad digital contra scamming y phishing.\n- Capacitación técnica en herramientas de Google Workspace',19500.00,0.00,'MXN','monthly','2026-06-03 22:50:16','2026-06-03 22:50:16',0,NULL,'[]',12);
/*!40000 ALTER TABLE `services` ENABLE KEYS */;
UNLOCK TABLES;
