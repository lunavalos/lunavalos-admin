(15,'LunAvalos','2026-05-21','2026-06-05',1.00,0.00,'MXN',1.00000000,'626',1,16.0000,0.16,0,0.0000,0.00,0,0.0000,0.00,1.16,NULL,NULL,NULL,NULL,NULL,0,1,0,'2026-05-21 17:57:51','2026-05-21 18:07:13','Joanna Avalos','8442751165','lunavalos@gmail.com','Contrato Firmado',21,37,12),
(17,'Elcco Group','2026-06-02','2026-06-17',15000.00,0.00,'MXN',1.00000000,'601',1,16.0000,2400.00,1,2.5000,375.00,0,0.0000,0.00,17025.00,'Contrato a 12 meses','Servicio completo de Seo + Email Marketing van muy de la mano, en conjunto se trabaja contenido para la marca interesantes para la industria.',NULL,NULL,NULL,0,1,0,'2026-06-02 16:49:32','2026-06-02 16:49:32','Cinthya Hurtado','8441025531','victor.menchaca@elccogroup.com','Borrador',11,39,12),
