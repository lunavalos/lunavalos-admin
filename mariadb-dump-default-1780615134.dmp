(147,52,9,'<p><strong>Solucion:</strong></p><p><br></p><ul><li>aumentar memory_limit =&gt; 1286M =&gt; 256M</li><li>Restart del sudo systemctl restart php8.4-fpm</li><li>php artisan config:clear &amp;&amp; php artisan cache:clear &amp;&amp; php artisan view:clear</li><li>rm -f storage/logs/*.log*</li><li>ls -lh storage/logs/</li><li>touch storage/logs/laravel.log</li><li>schmod 666 storage/logs/laravel.log</li></ul><p><br></p><p>&nbsp;</p><p><br></p>','tickets/attachments/xmJvvJIa8MiyNBQiu84fDihtXLD7Cu9h9OlSV5aJ.png','2026-05-06 16:21:23','2026-05-06 16:21:23'),
