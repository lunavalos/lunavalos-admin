DROP TABLE IF EXISTS `client_payments`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!40101 SET character_set_client = utf8mb4 */;
CREATE TABLE `client_payments` (
  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,
  `client_id` bigint(20) unsigned DEFAULT NULL,
  `contract_id` bigint(20) unsigned DEFAULT NULL,
  `quote_id` bigint(20) unsigned DEFAULT NULL,
  `registered_by_user_id` bigint(20) unsigned DEFAULT NULL,
  `type` varchar(30) NOT NULL DEFAULT 'mensualidad',
  `status` varchar(20) NOT NULL DEFAULT 'registrado',
  `concept` varchar(255) DEFAULT NULL,
  `amount` decimal(12,2) NOT NULL DEFAULT 0.00,
  `currency` varchar(3) NOT NULL DEFAULT 'MXN',
  `exchange_rate` decimal(18,8) NOT NULL DEFAULT 1.00000000,
  `payment_method` varchar(30) DEFAULT NULL,
  `reference` varchar(100) DEFAULT NULL,
  `paid_at` date DEFAULT NULL,
  `due_date` date DEFAULT NULL,
  `installment_number` smallint(5) unsigned DEFAULT NULL,
  `evidence_file_path` varchar(255) DEFAULT NULL,
  `notes` text DEFAULT NULL,
  `created_at` timestamp NULL DEFAULT NULL,
  `updated_at` timestamp NULL DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `client_payments_quote_id_foreign` (`quote_id`),
  KEY `client_payments_registered_by_user_id_foreign` (`registered_by_user_id`),
  KEY `client_payments_client_id_paid_at_index` (`client_id`,`paid_at`),
  KEY `client_payments_contract_id_type_index` (`contract_id`,`type`),
  KEY `client_payments_status_index` (`status`),
  KEY `client_payments_status_due_date_index` (`status`,`due_date`),
  CONSTRAINT `client_payments_client_id_foreign` FOREIGN KEY (`client_id`) REFERENCES `clients` (`id`) ON DELETE SET NULL,
  CONSTRAINT `client_payments_contract_id_foreign` FOREIGN KEY (`contract_id`) REFERENCES `contracts` (`id`) ON DELETE SET NULL,
  CONSTRAINT `client_payments_quote_id_foreign` FOREIGN KEY (`quote_id`) REFERENCES `quotes` (`id`) ON DELETE SET NULL,
  CONSTRAINT `client_payments_registered_by_user_id_foreign` FOREIGN KEY (`registered_by_user_id`) REFERENCES `users` (`id`) ON DELETE SET NULL
) ENGINE=InnoDB AUTO_INCREMENT=46 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
