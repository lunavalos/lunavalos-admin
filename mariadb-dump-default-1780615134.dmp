(89,'Reels #1 — Jun 2026',NULL,'Media','En Revisión','recurring',46,NULL,3,9,1,'2026-06-03 15:39:19',NULL,NULL,16,9,NULL,0,'2026-05-29 13:46:20','2026-06-03 15:39:21',NULL),
(90,'Reels #2 — Jun 2026','voz en off: ¿Sabes exactamente dónde está tu envío en este momento?\nSin rastreo, dependes de llamadas, mensajes y esperanza. Eso no es control — es azar.\nEn Absolute, todas nuestras unidades cuentan con GPS y monitoreo en tiempo real.  Sabemos dónde está tu carga en cada etapa del trayecto.\nSin sorpresas. Sin llamadas al vacío.  Tomas decisiones con información real, no con suposiciones.\nTransporte con visibilidad total.  Absolute Group.','Media','En Revisión','recurring',46,NULL,3,9,2,'2026-05-29 15:27:06',NULL,NULL,16,9,NULL,0,'2026-05-29 14:08:35','2026-06-03 15:40:17',NULL),
(91,'Reels #3 — Jun 2026','Voz en off : Antes de confiarle tu mercancía a alguien, hay tres preguntas que toda empresa debe hacer.\nPregunta uno: ¿hacen el cruce fronterizo directo o usan transportistas de terceros? Si usan terceros, tienes más riesgo y menos control.\nPregunta dos: ¿tienen rastreo satelital en tiempo real? No basta con actualizaciones esporádicas — necesitas ver la posición de tu carga cuando quieras.\n Pregunta tres: ¿manejan la documentación aduanal o te dejan solo con eso? Un error de papeles detiene todo.\nEn Absolute la respuesta a las tres es sí. Cruce directo, rastreo total y gestión de documentación incluida.\nescríbenos. Te esperamos.','Media','En Revisión','recurring',46,NULL,3,9,3,'2026-05-29 15:27:16',NULL,NULL,16,9,NULL,0,'2026-05-29 14:23:20','2026-06-03 15:41:09',NULL),
(92,'Reels #4 — Jun 2026','Voz en off: Hay muchas opciones de transporte entre México y Estados Unidos. Absolute no compite en precio. Compite en confiabilidad.\nPrimero: nuestros camiones hacen el cruce directo. Sin intermediarios, sin transferencias, sin riesgos adicionales. Tu carga viaja con nosotros de inicio a fin.\nSegundo: rastreo satelital en tiempo real, las 24 horas. Tú siempre sabes dónde está tu mercancía, sin preguntar.\nTercero: años operando en la frontera México-EE.UU. Conocemos los cruces, los tiempos y los protocolos mejor que nadie.\nEsto es lo que pones detrás de cada envío cuando eliges Absolute.\nElige confianza. Elige Absolute Group.','Media','En Revisión','recurring',46,NULL,3,NULL,NULL,'2026-05-29 15:27:24',NULL,NULL,16,9,NULL,0,'2026-05-29 14:29:23','2026-06-03 15:41:47',NULL),
(93,'PRESENTACIÓN SICK X SYACSA','<p>1. Quiénes somos</p><p><br></p><p>* Historia de SYACSA.</p><p>* Años en el mercado.</p><p>* Ubicación.</p><p>* Misión y visión (resumidas).</p><p><br></p><p>1. Nuestras líneas de negocio</p><p><br></p><p>* Automatización industrial.</p><p>* Instrumentación.</p><p>* Control industrial.</p><p>* Integración.</p><p>* Servicios técnicos.</p><p><br></p><p>1. Marcas que representamos actualmente</p><p><br></p><p>* Banner Engineering</p><p>* Turck</p><p>* ⁠Altech Corp</p><p>* ⁠Patlite</p><p>* ⁠Euchner</p><p>* ⁠Delta Electronics</p><p>* ⁠Ingersoll&nbsp;</p><p><br></p><p>1. Cobertura comercial</p><p><br></p><p>* Industrias atendidas.</p><p>* Número de clientes activos.</p><p>* Principales cuentas.</p><p><br></p><p><br></p><p>1. Capacidad técnica</p><p><br></p><p>* Ingenieros de ventas.</p><p>* Soporte técnico.</p><p>* Capacitación a clientes.</p><p>* Levantamientos en planta.</p><p>* Selección de sensores.</p><p>* Puesta en marcha.</p><p><br></p><p>1. Casos de éxito</p><p>Te los paso yo en un momento</p><p><br></p><p>1. ¿Por qué SYACSA y SICK?</p><p><br></p><p>* Experiencia en automatización.</p><p>* Fuerza comercial establecida.</p><p>* Cobertura regional.</p><p>* Base de clientes industriales.</p><p>* Capacidad técnica.</p><p>* Marketing industrial activo.</p>','Alta','Completados','support',47,74,NULL,NULL,NULL,'2026-06-03 20:32:46',NULL,NULL,22,22,NULL,0,'2026-06-02 15:21:50','2026-06-03 20:32:46',NULL),
(94,'implementación de nuevos proveedores en el sitio web','<p>Realizar la integración de tres nuevos proveedores dentro de la seccion correspondiente del sitio: Altech Corp, Euchner y patlite. que incluya la la incorporación de su información, contenido y elementos visuales siguiendo la estructura y diseño actual </p><p><br></p>','Media','En Revisión','support',47,NULL,NULL,NULL,NULL,'2026-06-02 16:58:28','2026-06-02 16:32:34',NULL,15,9,NULL,0,'2026-06-02 15:28:25','2026-06-02 16:58:28',NULL),
(95,'Soporte cambio de numero','<p>cambiar el numero actual por 844 357 1774</p>','Media','En Revisión','support',3,1,NULL,NULL,NULL,'2026-06-04 17:36:02','2026-06-04 16:33:09',NULL,9,9,'2026-06-03 00:00:00',0,'2026-06-02 17:12:26','2026-06-04 17:36:04',NULL),
(96,'Ticket de prueba','<p>test</p>','Media','En Proceso','support',21,124,NULL,NULL,NULL,'2026-06-03 17:01:53',NULL,NULL,9,9,'2026-06-04 00:00:00',0,'2026-06-03 17:01:53','2026-06-03 17:01:53',NULL),
(97,'Correcciones CRM','<p>Listado de Correcciones:</p><p><br></p><ol><li>Visualización de tickets recurrentes en panel del cliente (solo los del cliente)</li><li>Mejorar la visualización de los tickets (tarjetas más compactas)</li><li>Archivar tickets completados que tengan más de 1 mes de cerrados.</li><li>Activar filtros por cliente, y ajustar para que los filtros se conserven como preferencias del usuario.</li></ol>','Media','En Revisión','support',21,124,NULL,NULL,NULL,'2026-06-03 19:48:54',NULL,NULL,1,9,'2026-06-04 00:00:00',0,'2026-06-03 17:39:16','2026-06-03 19:48:55',NULL),
(98,'Promoción del mundial x Syacsa','<h2><strong>Carrusel de \"</strong>¿Qué jugador sería cada producto?<strong>\"</strong></h2><p><br></p><p>🐐 Messi = Sensor inductivo Banner EG08K</p><p>\"Pequeño, preciso y aparece cuando más lo necesitas.\"</p><p><br></p><p>🚀 Kylian Mbappé = Encoder incremental</p><p>\"Nadie mide la velocidad mejor que él.\"</p><p><br></p><p>✨ Lamine Yamal = Sensor fotoeléctrico miniatura</p><p>\"Todavía es pequeño, pero ya está resolviendo problemas de nivel profesional.\"</p><p><br></p><p>🧠 Kevin De Bruyne = PLC Siemens S7-1200</p><p>\"No es el que más corre, es el que hace jugar a todos.\"</p><p><br></p><p>🎯 Cristiano Ronaldo = Cámara de visión Banner VE</p><p>\"Obsesionado con la precisión y los resultados.\"</p><p><br></p><p>🦾 Haaland = Sensor ultrasónico Turck</p><p>\"Grande, potente y detecta donde otros no llegan.\"</p><p><br></p><p>🔥 Vinicius Jr. = Sensor fotoeléctrico Q4X Banner</p><p>\"Rápido, explosivo y difícil de detener.\"</p><p><br></p><p>😅 Piqué = Manual de usuario</p><p>\"Todos dicen que es importante, pero casi nadie le hace caso.\"</p><p><br></p><p>🧱 Sergio Ramos = Sensor inductivo Turck</p><p>\"Años y años jugando al máximo nivel.\"</p><p><br></p><p>🎩 Luka Modric = HMI Turck</p><p>\"Hace que todo se vea sencillo.\"</p><p><br></p><p>⚡ Pedri = Sensor miniatura Banner QS18</p><p>\"Joven, pequeño y sorprendentemente bueno.\"</p><p><br></p><p>🧤 Emiliano Martínez = Relé de seguridad Banner</p><p>\"Aparece en los momentos de máxima presión.\"</p><h3><br></h3>','Media','En Revisión','support',47,NULL,NULL,NULL,NULL,'2026-06-04 18:45:09',NULL,NULL,22,22,NULL,0,'2026-06-03 22:36:07','2026-06-04 18:45:09',NULL);
