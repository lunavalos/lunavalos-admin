--
-- Table structure for table `invoices`
--

DROP TABLE IF EXISTS `invoices`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!40101 SET character_set_client = utf8mb4 */;
CREATE TABLE `invoices` (
  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,
  `client_id` bigint(20) unsigned NOT NULL,
  `contract_id` bigint(20) unsigned DEFAULT NULL,
  `client_payment_id` bigint(20) unsigned DEFAULT NULL,
  `issued_by_user_id` bigint(20) unsigned DEFAULT NULL,
  `facturama_id` varchar(255) DEFAULT NULL,
  `uuid` varchar(64) DEFAULT NULL,
  `series` varchar(20) DEFAULT NULL,
  `folio` varchar(20) DEFAULT NULL,
  `cfdi_type` varchar(5) NOT NULL DEFAULT 'I',
  `payment_method` varchar(5) NOT NULL DEFAULT 'PUE',
  `payment_form` varchar(5) DEFAULT NULL,
  `cfdi_use` varchar(10) DEFAULT NULL,
  `currency` varchar(5) NOT NULL DEFAULT 'MXN',
  `exchange_rate` decimal(18,8) NOT NULL DEFAULT 1.00000000,
  `original_currency` varchar(3) DEFAULT NULL,
  `original_amount` decimal(14,2) DEFAULT NULL,
  `subtotal` decimal(12,2) NOT NULL DEFAULT 0.00,
  `discount` decimal(12,2) NOT NULL DEFAULT 0.00,
  `taxes` decimal(12,2) NOT NULL DEFAULT 0.00,
  `retentions` decimal(12,2) NOT NULL DEFAULT 0.00,
  `total` decimal(12,2) NOT NULL DEFAULT 0.00,
  `status` varchar(20) NOT NULL DEFAULT 'issued',
  `cancellation_status` varchar(20) DEFAULT NULL,
  `issued_at` timestamp NULL DEFAULT NULL,
  `canceled_at` timestamp NULL DEFAULT NULL,
  `xml_path` varchar(255) DEFAULT NULL,
  `pdf_path` varchar(255) DEFAULT NULL,
  `request_snapshot` longtext CHARACTER SET utf8mb4 COLLATE utf8mb4_bin DEFAULT NULL CHECK (json_valid(`request_snapshot`)),
  `response_snapshot` longtext CHARACTER SET utf8mb4 COLLATE utf8mb4_bin DEFAULT NULL CHECK (json_valid(`response_snapshot`)),
  `error_message` text DEFAULT NULL,
  `created_at` timestamp NULL DEFAULT NULL,
  `updated_at` timestamp NULL DEFAULT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `invoices_uuid_unique` (`uuid`),
  KEY `invoices_client_payment_id_foreign` (`client_payment_id`),
  KEY `invoices_issued_by_user_id_foreign` (`issued_by_user_id`),
  KEY `invoices_client_id_status_index` (`client_id`,`status`),
  KEY `invoices_contract_id_status_index` (`contract_id`,`status`),
  KEY `invoices_facturama_id_index` (`facturama_id`),
  CONSTRAINT `invoices_client_id_foreign` FOREIGN KEY (`client_id`) REFERENCES `clients` (`id`) ON DELETE CASCADE,
  CONSTRAINT `invoices_client_payment_id_foreign` FOREIGN KEY (`client_payment_id`) REFERENCES `client_payments` (`id`) ON DELETE SET NULL,
  CONSTRAINT `invoices_contract_id_foreign` FOREIGN KEY (`contract_id`) REFERENCES `contracts` (`id`) ON DELETE SET NULL,
  CONSTRAINT `invoices_issued_by_user_id_foreign` FOREIGN KEY (`issued_by_user_id`) REFERENCES `users` (`id`) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

