      "parameters": {
        "jsCode": "// Compara el secreto compartido en tiempo constante.\n// Debe coincidir con N8N_SHARED_SECRET del .env de Laravel.\nconst esperado = $env.LUNAVALOS_SHARED_SECRET;\nconst recibido = $input.first().json.headers['x-n8n-secret'] || '';\n\nconst crypto = require('crypto');\nconst a = Buffer.from(String(esperado));\nconst b = Buffer.from(String(recibido));\nconst ok = a.length === b.length && crypto.timingSafeEqual(a, b);\n\nif (!esperado || !ok) {\n  throw new Error('Secreto invalido');\n}\n\nreturn $input.all();"
      },
      "id": "valida-secreto",
      "name": "Valida secreto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
