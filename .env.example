APP_NAME="LunAvalos Digital House"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# `log` sirve en local: escribe los eventos al log y no exige tener Reverb
# corriendo. En PRODUCCIÓN tiene que ser `reverb` o la bandeja de
# Conversaciones no se actualiza sola.
#
# Ojo con el falso verde: si falta esta variable, el default del código es
# `null` y broadcast() no hace nada, pero /broadcasting/auth sigue devolviendo
# 200 —autoriza el canal, que es otra cosa— y los tests con Event::fake()
# siguen pasando, porque prueban que se llama, no que se entregue.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Facebook Login for Business — ID de la configuración que declara los activos
# (páginas, cuentas de IG) y los permisos que concede el usuario.
# Se crea en el panel: Facebook Login for Business → Configurations.
# SIN esto, el diálogo de Meta solo concede perfil básico y nunca ofrece elegir
# páginas, aunque los scopes estén aprobados en App Review.
FACEBOOK_LOGIN_CONFIG_ID=
INSTAGRAM_LOGIN_CONFIG_ID=

# Cuenta que se entrega a los revisores de plataforma (Meta App Review, etc).
# Solo para la instancia demo: PlatformReviewerSeeder se niega a correr contra
# el dominio de producción, porque un revisor externo no debe ver clientes
# reales ni conversaciones de WhatsApp de clientes finales.
REVIEWER_EMAIL=platform-reviewer@lunavalos.com
REVIEWER_PASSWORD=

# WhatsApp — entrada: Meta llama directo a {APP_URL}/whatsapp/webhook.
# WHATSAPP_VERIFY_TOKEN lo eliges tú y lo copias igual en el panel de Meta.
# WHATSAPP_APP_SECRET es el App Secret de la app (Settings > Basic): con él se
# valida X-Hub-Signature-256. Sin estas dos, el webhook rechaza todo.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v26.0

# WhatsApp — salida: este sistema llama directo a graph.facebook.com.
# WHATSAPP_TOKEN es el token permanente del system user (expiración Never), con
# whatsapp_business_messaging y whatsapp_business_management.
# Sin token o sin phone_number_id no se envía nada y solo queda un warning.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TIMEOUT=10

# WhatsApp — Embedded Signup: configuration_id del flujo creado en el panel de
# Meta. Es lo único que permite onboardear la WABA de un cliente: Meta no acepta
# que el cliente nos pegue un token a mano.
# El de LunAvalos Social se creó el 2026-08-17 con expiración de token "Never":
# la caducidad se fija al crear la configuración y Meta no deja cambiarla
# después. La variante de 60 días obligaría a que cada cliente rehiciera el
# Embedded Signup cada dos meses.
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=1006528675722697
